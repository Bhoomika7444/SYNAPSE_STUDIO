# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/synapse-studio
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/synapse-studio
MONGODB_URI=mongodb://127.0.0.1:27017/synapse-studio

# Any long random string (used to sign login sessions/JWTs)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Google AI Studio API key (https://aistudio.google.com/apikey)
# Required for the "Generate" / Logo / Enhance / 3D / Animation buttons.
GEMINI_API_KEY=your_gemini_api_key_here

# URL of the deployed frontend (for CORS). Use * for local development.
CLIENT_URL=http://localhost:8080

PORT=5000
